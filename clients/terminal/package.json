{
  "name": "@vexa/terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vexa Terminal — an AI-first knowledge-worker terminal (Claude Code × Outlook) on the Vexa meeting-bot + agentic-runtime backend. Self-hostable (VPC / air-gapped) with BYO inference.",
  "scripts": {
    "dev": "PORT=3000 node server.mjs",
    "build": "next build",
    "start": "PORT=3000 NODE_ENV=production node server.mjs",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@mdx-js/mdx": "^3.1.1",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "allotment": "^1.20.6",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview": "^8.6.1",
    "dockview-react": "^8.6.1",
    "geist": "^1.8.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0",
    "tinykeys": "^4.0.1",
    "ws": "^8.22.0",
