    "@types/mdx": "^2.0.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "_overrides_comment": "Advisory floors for transitive deps of the SHIPPED terminal image, which is built with `npm ci` from package-lock.json (see Dockerfile) and therefore does not see pnpm-workspace.yaml's overrides. Keep the two lists in sync for any package present in both trees.",
  "overrides": {
    "postcss": ">=8.5.23",
    "nanoid": "^3.3.18",
